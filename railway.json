{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "gunicorn smk_lms.wsgi --workers 2 --timeout 120 --log-file -",
    "preDeployCommand": "python manage.py migrate --noinput && python -X utf8 seed_data.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
